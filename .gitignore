.venv/
__pycache__/
*.pyc
.pytest_cache/
# Raw data stays local; the derived CVE table (D11) is tracked.
data/*
!data/derived/
runs/
.DS_Store
# Run outputs stay local; only the directory skeleton is tracked.
results/*
!results/raw/
results/raw/*
!results/raw/.gitkeep
# Measurement runs (raw.json, report.md, provenance.json) are tracked.
!results/landscape/
!results/feasibility/
# Training runs (with checkpoints) and validation evaluations are tracked (D21).
!results/training/
!results/evaluation/
# WL checkpoints are ~70 MB (1.9M-colour vocabulary); local only, SHA-256 in D21 amendment 2.
results/training/**/wl-*/**/model.pt
# Every read of a test split (D17 §4, D19 §1) is tracked.
!results/test_access_log.jsonl
docs/ai_usage_log.md
third_party/
logs/
